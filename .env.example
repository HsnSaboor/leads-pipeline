# Evolution API Configuration
# Copy this file to .env and fill in your values

# Required: Your Evolution API key
EVOLUTION_API_KEY=your_api_key_here

# Optional: Evolution API URL (default: https://evoapi.botomation.tech)
EVOLUTION_API_URL=https://evoapi.botomation.tech

# Optional: Instance name to use (default: demo)
EVOLUTION_INSTANCE=demo
